  "cards": [
    {
      "dot": "cyan",
      "title": "The central decision",
      "items": [
        "The production tracker IS the state machine",
        "No queue, no job file, no second admin tool nobody opens",
        "Every arrow reads or writes a tracker field",
        "So the record of what ran lands where the production already looks"
      ]
    },
    {
      "dot": "emerald",
      "title": "Every gate is a person",
      "items": [
        "A deterministic check can only REFUSE, never approve",
        "It parks the work and says why; the decision stays with a human",
        "The one step that costs GPU time re-reads the approval on the way in",
        "Nothing self-approves, and that is the product"
      ]
    },
    {
      "dot": "rose",
      "title": "Why it is auditable",
      "items": [
        "Provenance is written by the code that sent the prompt",
        "A mismatch is posted as a Note, and reports rather than blocks",
        "A vision QC gate measured 38% and was switched off, not tuned",
        "A canary is proven to trip before any clean result is believed"
      ]
    }
  ]
